<?xml version="1.0" encoding="utf-8"?>
<Mod id="detailed-wonder-cinematic-continued" version="1.1"
	xmlns="ModInfo">
	<Properties>
		<Name>Detailed Wonder Cinematic (Continued)</Name>
		<Description>Displays wonder effects on the wonder completion &amp; natural wonder discovery cinematics. Updated for patches 1.2.4+.</Description>
		<Authors>Argyuile</Authors>
		<Package>Mod</Package>
		<AffectsSavedGames>0</AffectsSavedGames>
		<Version>1.1</Version>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="detailed-wonder-cinematic-continued-modifications-always" scope="game" criteria="always">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<Actions>
				<UIScripts>
					<Item>code/wonder-cinematic-decorator.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>
	</ActionGroups>
</Mod>
